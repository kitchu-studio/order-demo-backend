# Copy to .env and change every value. Never commit .env
APP_ENV=development
PORT=8080

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Domain served by Caddy (use "localhost" for local, your real domain on the server)
DOMAIN=localhost

# Shop shown in the app
SHOP_NAME=ร้านกาแฟตัวอย่าง

# Who receives the money: a Thai mobile number (10 digits) or a 13-digit national/tax id.
# The app only shows a QR code for this id; no bank connection is involved.
PROMPTPAY_ID=0812345678

# Comma-separated emails. Whoever registers with one of these becomes a shop admin
# (can mark orders paid / preparing / ready and sell out menu items).
ADMIN_EMAILS=owner@example.com
